# ───────────────────────────────────────────────
#                Tauri-specific
# ───────────────────────────────────────────────
**/src-tauri/target/
**/src-tauri/gen/
**/src-tauri/Cargo.lock          # ← usually ignored unless you want reproducible builds
**/src-tauri/bundle/
**/src-tauri/*.log
**/src-tauri/build.rs.bak

# Icons & resources that are auto-generated / temporary
src-tauri/icons/*.ico
src-tauri/icons/*.png
src-tauri/icons/icon.icns

# Debug symbols & profiler data (very large)
src-tauri/target/**/*.pdb
src-tauri/target/**/*.dSYM
src-tauri/target/**/*.debug

# Bundler / packager temporary files
*.deb
*.rpm
*.msi
*.pkg
*.dmg
*.AppImage
tauri.updater.json

